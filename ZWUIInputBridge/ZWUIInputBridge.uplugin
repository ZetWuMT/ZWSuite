{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "ZWUIInputBridge",
	"Description": "Optional bridge plugin. Keeps ZWUICore's UZWInputConfig reference in sync with ZWInput's, so both plugins use a single source of truth instead of two independent copies. Enable this ONLY if your project uses BOTH ZWInput and ZWUICore. If you only use one of them (or neither), leave this plugin disabled - ZWInput and ZWUICore have zero compile-time or runtime awareness of each other or of this bridge.",
	"Category": "ZW/Bridges",
	"CreatedBy": "",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"EnabledByDefault": false,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "ZWUIInputBridge",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "ZWInput",
			"Enabled": true
		},
		{
			"Name": "ZWUICore",
			"Enabled": true
		}
	]
}
